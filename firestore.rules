rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function me() { return request.auth.uid; }
    function role() { return get(/databases/$(db)/documents/users/$(me())).data.role; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function tenantKeys() { return ['status','tenantUid','tenantName','paymentStatus','reservedAt','departureRequested']; }

    match /users/{uid} {
      allow read: if request.auth != null && me() == uid;
      allow create: if request.auth != null && me() == uid && request.resource.data.uid == uid && request.resource.data.role in ['owner','tenant'];
      allow update: if request.auth != null && me() == uid && request.resource.data.role == resource.data.role;
    }
    match /apartments/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && role() == 'owner' && request.resource.data.ownerUid == me() && request.resource.data.status == 'Disponible';
      allow update: if request.auth != null && (
        (resource.data.ownerUid == me() && request.resource.data.ownerUid == resource.data.ownerUid)
        || (role() == 'tenant' && resource.data.status == 'Disponible' && request.resource.data.status == 'Réservé' && request.resource.data.tenantUid == me() && changed().hasOnly(tenantKeys()))
        || (resource.data.get('tenantUid', null) == me() && resource.data.status == 'Réservé' && request.resource.data.status == 'Disponible' && changed().hasOnly(tenantKeys()))
        || (resource.data.get('tenantUid', null) == me() && resource.data.status == 'Loué' && changed().hasOnly(['departureRequested'])));
      allow delete: if request.auth != null && resource.data.ownerUid == me() && resource.data.status == 'Disponible';
    }
  }
}
