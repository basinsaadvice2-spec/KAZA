rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function me() { return request.auth.uid; }
    function role() { return get(/databases/$(db)/documents/users/$(me())).data.role; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function tenantKeys() { return ['status','tenantUid','tenantName','paymentStatus','reservedAt','departureRequested']; }

    match /users/{uid} {
      allow read: if request.auth != null && me() == uid;
      allow create: if request.auth != null && me() == uid && request.resource.data.uid == uid && request.resource.data.role in ['owner','tenant'];
      allow update: if request.auth != null && me() == uid && request.resource.data.role == resource.data.role;
    }
    match /apartments/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && role() == 'owner' && request.resource.data.ownerUid == me() && request.resource.data.status == 'Disponible';
      allow update: if request.auth != null && (
        (resource.data.ownerUid == me() && request.resource.data.ownerUid == resource.data.ownerUid)
        || (role() == 'tenant' && resource.data.status == 'Disponible' && request.resource.data.status == 'Réservé' && request.resource.data.tenantUid == me() && changed().hasOnly(tenantKeys()))
        || (resource.data.get('tenantUid', null) == me() && resource.data.status == 'Réservé' && request.resource.data.status == 'Disponible' && changed().hasOnly(tenantKeys()))
        || (resource.data.get('tenantUid', null) == me() && resource.data.status == 'Loué' && changed().hasOnly(['departureRequested'])));
      allow delete: if request.auth != null && resource.data.ownerUid == me() && resource.data.status == 'Disponible';
    }
 
    match /payments/{id} {
      allow read: if request.auth != null && (resource.data.ownerUid == me() || resource.data.tenantUid == me());
      allow create: if request.auth != null && request.resource.data.tenantUid == me() && request.resource.data.status == 'En attente'
        && get(/databases/$(db)/documents/apartments/$(request.resource.data.aptId)).data.get('tenantUid', null) == me()
        && get(/databases/$(db)/documents/apartments/$(request.resource.data.aptId)).data.status == 'Loué'
        && get(/databases/$(db)/documents/apartments/$(request.resource.data.aptId)).data.ownerUid == request.resource.data.ownerUid;
      allow update: if request.auth != null && resource.data.ownerUid == me() && resource.data.status == 'En attente'
        && request.resource.data.status in ['Validé', 'Refusé'] && changed().hasOnly(['status','decidedAt','receiptNo','refusalReason']);
    }
    match /chats/{cid} {
      allow get: if request.auth != null && (resource == null || me() in resource.data.participants);
      allow list: if request.auth != null && me() in resource.data.participants;
      allow create: if request.auth != null && me() in request.resource.data.participants && request.resource.data.participants.size() == 2
        && cid == request.resource.data.aptId + '_' + request.resource.data.tenantUid;
      allow update: if request.auth != null && me() in resource.data.participants && changed().hasOnly(['lastMessage','lastAt','lastSender']);
      match /messages/{mid} {
        allow read: if request.auth != null && me() in get(/databases/$(db)/documents/chats/$(cid)).data.participants;
        allow create: if request.auth != null && me() in get(/databases/$(db)/documents/chats/$(cid)).data.participants && request.resource.data.senderUid == me();
      }
    }
    match /notifications/{nid} {
      allow create: if request.auth != null && request.resource.data.fromUid == me();
      allow read, delete: if request.auth != null && resource.data.toUid == me();
      allow update: if request.auth != null && resource.data.toUid == me() && changed().hasOnly(['read']);
    }
  }
}
