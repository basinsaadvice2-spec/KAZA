rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function userPath(uid) { return /databases/$(db)/documents/users/$(uid); }
    function apartmentPath(id) { return /databases/$(db)/documents/apartments/$(id); }
    function role() { return get(userPath(me())).data.get('role', null); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function availability(apartment) {
      return apartment.get('availabilityStatus', apartment.get('status', null));
    }
    function validPhoto(photo, allowLegacyUrl) {
      return photo is string && (
        (photo.size() <= 205000 && photo.matches('^data:image/(webp|jpeg);base64,[A-Za-z0-9+/]+={0,2}$'))
        || (allowLegacyUrl && photo.size() <= 2048 && photo.matches('^https://.*$'))
      );
    }
    function validPhotoAt(photos, index, allowLegacyUrl) {
      return photos.size() <= index || validPhoto(photos[index], allowLegacyUrl);
    }
    function validPhotos(allowLegacyUrl) {
      let photos = request.resource.data.photos;
      return photos is list && photos.size() >= 1 && photos.size() <= 4
        && validPhotoAt(photos, 0, allowLegacyUrl)
        && validPhotoAt(photos, 1, allowLegacyUrl)
        && validPhotoAt(photos, 2, allowLegacyUrl)
        && validPhotoAt(photos, 3, allowLegacyUrl);
    }
    function tenantKeys() { return ['status','availabilityStatus','tenantUid','tenantName','paymentStatus','reservedAt','departureRequested','departureReviewId']; }
    function listingKeys() {
      return ['id','title','avenue','landmark','reference','rates','price','type','commune',
        'propertyNumber','unitNumber','buildingName','garantie','snel','water','mapsUrl',
        'photos','photoUrl','ownerId','ownerUid','status','availabilityStatus',
        'ownerEmail','ownerName','ownerPhone','ownerType','updatedAt'];
    }
    function clearsTenant() {
      return request.resource.data.status == 'publie'
        && request.resource.data.availabilityStatus == 'Disponible'
        && request.resource.data.get('tenantUid', null) == null
        && request.resource.data.get('tenantName', null) == null
        && request.resource.data.get('paymentStatus', null) == null
        && request.resource.data.get('departureRequested', false) == false
        && request.resource.data.get('departureReviewId', null) == null
        && request.resource.data.get('reservedAt', null) == null;
    }

    match /users/{uid} {
      allow read: if signedIn() && me() == uid;
      allow create: if signedIn() && me() == uid
        && request.resource.data.uid == uid
        && request.resource.data.role in ['owner', 'tenant']
        && ((request.resource.data.role == 'owner' && request.resource.data.accountType in ['owner', 'agency'])
          || (request.resource.data.role == 'tenant' && request.resource.data.accountType == 'tenant'));
      allow update: if signedIn() && me() == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.accountType == resource.data.accountType
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notificationPrefs','savedSearch']);
      allow delete: if false;

      match /pushTokens/{fidId} {
        function validPushData() {
          return request.resource.data.keys().hasOnly(['fid','enabled','createdAt','updatedAt'])
            && request.resource.data.fid is string
            && request.resource.data.enabled == true;
        }
        allow read, delete: if signedIn() && me() == uid;
        allow create, update: if signedIn() && me() == uid && validPushData();
      }

      match /followedApartments/{apartmentId} {
        function pairedFollowerExists() {
          return existsAfter(/databases/$(db)/documents/apartments/$(apartmentId)/followers/$(me()));
        }
        allow read: if signedIn() && me() == uid && role() == 'tenant';
        allow create: if signedIn() && me() == uid && role() == 'tenant'
          && request.resource.data.uid == uid
          && request.resource.data.apartmentId == apartmentId
          && request.resource.data.keys().hasOnly(['uid','apartmentId','ownerUid','title','createdAt'])
          && get(apartmentPath(apartmentId)).data.status == 'publie'
          && availability(get(apartmentPath(apartmentId)).data) == 'Disponible'
          && get(apartmentPath(apartmentId)).data.ownerUid == request.resource.data.ownerUid
          && pairedFollowerExists();
        allow delete: if signedIn() && me() == uid && role() == 'tenant'
          && !pairedFollowerExists();
        allow update: if false;
      }
    }

    match /publicProfiles/{uid} {
      allow get: if signedIn() && (me() == uid || (role() == 'tenant' && resource.data.role == 'owner'));
      allow list: if false;
      allow create: if signedIn() && me() == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == get(userPath(uid)).data.role
        && request.resource.data.role in ['owner', 'tenant']
        && ((request.resource.data.role == 'owner' && request.resource.data.accountType in ['owner', 'agency'])
          || (request.resource.data.role == 'tenant' && request.resource.data.accountType == 'tenant'))
        && request.resource.data.keys().hasOnly(['uid','name','phone','role','accountType']);
      allow update: if signedIn() && me() == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.role == get(userPath(uid)).data.role
        && ((request.resource.data.role == 'owner' && request.resource.data.accountType in ['owner', 'agency'])
          || (request.resource.data.role == 'tenant' && request.resource.data.accountType == 'tenant'))
        && request.resource.data.keys().hasOnly(['uid','name','phone','role','accountType']);
      allow delete: if false;
    }

    match /tenantReferences/{tenantUid}/reviews/{reviewId} {
  // Lecture temporairement bloquée pour éviter l'accès
  // aux évaluations de locataires sans autorisation vérifiée.
  allow get, list: if false;
      allow create: if signedIn() && role() == 'owner'
        && request.resource.data.keys().hasAll(['tenantUid','reviewerUid','apartmentId','apartmentTitle','paymentSpeed','propertyCare','createdAt'])
        && request.resource.data.keys().hasOnly(['tenantUid','reviewerUid','apartmentId','apartmentTitle','paymentSpeed','propertyCare','createdAt'])
        && request.resource.data.tenantUid == tenantUid
        && request.resource.data.reviewerUid == me()
        && request.resource.data.apartmentId is string
        && request.resource.data.apartmentId.size() > 0
        && request.resource.data.apartmentTitle is string
        && request.resource.data.apartmentTitle.size() <= 180
        && request.resource.data.paymentSpeed is int
        && request.resource.data.paymentSpeed >= 1 && request.resource.data.paymentSpeed <= 5
        && request.resource.data.propertyCare is int
        && request.resource.data.propertyCare >= 1 && request.resource.data.propertyCare <= 5
        && request.resource.data.createdAt is timestamp
        && get(apartmentPath(request.resource.data.apartmentId)).data.ownerUid == me()
        && get(apartmentPath(request.resource.data.apartmentId)).data.tenantUid == tenantUid
        && availability(get(apartmentPath(request.resource.data.apartmentId)).data) == 'Loué'
        && get(apartmentPath(request.resource.data.apartmentId)).data.get('departureRequested', false) == true
        && getAfter(apartmentPath(request.resource.data.apartmentId)).data.get('departureReviewId', null) == reviewId
        && getAfter(apartmentPath(request.resource.data.apartmentId)).data.get('tenantUid', null) == null
        && availability(getAfter(apartmentPath(request.resource.data.apartmentId)).data) == 'Disponible';
      allow update, delete: if false;
    }

    match /apartments/{id} {
      allow get, list: if signedIn() && (
        (role() == 'owner' && resource.data.ownerUid == me())
        || (role() == 'tenant' && (
          (resource.data.status == 'publie' && availability(resource.data) == 'Disponible')
          || resource.data.get('tenantUid', null) == me()
        ))
      );
      allow create: if signedIn() && role() == 'owner'
        && request.resource.data.ownerUid == me()
        && request.resource.data.ownerId == me()
        && request.resource.data.status == 'publie'
        && request.resource.data.availabilityStatus == 'Disponible'
        && validPhotos(false)
        && request.resource.data.keys().hasOnly([
          'id','title','avenue','landmark','reference','rates','price','type','commune',
          'propertyNumber','unitNumber','buildingName','garantie','snel','water','mapsUrl','photos',
          'ownerId','ownerUid','ownerEmail','ownerName','ownerPhone','ownerType',
          'updatedAt','status','availabilityStatus','createdAt'
        ]);
      allow update: if signedIn() && (
        (resource.data.ownerUid == me() && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.ownerId == me()
          && request.resource.data.status == 'publie'
          && request.resource.data.availabilityStatus == availability(resource.data)
          && validPhotos(true) && changed().hasOnly(listingKeys()))
        || (resource.data.ownerUid == me() && availability(resource.data) == 'Réservé'
          && request.resource.data.status == 'publie' && request.resource.data.availabilityStatus == 'Loué'
          && request.resource.data.tenantUid == resource.data.tenantUid
          && request.resource.data.paymentStatus == 'En attente' && changed().hasOnly(['status','availabilityStatus','paymentStatus']))
        || (resource.data.ownerUid == me() && availability(resource.data) == 'Loué'
          && request.resource.data.paymentStatus == 'À jour' && changed().hasOnly(['paymentStatus']))
        || (resource.data.ownerUid == me() && availability(resource.data) == 'Réservé' && clearsTenant()
          && changed().hasOnly(tenantKeys()))
        || (resource.data.ownerUid == me() && availability(resource.data) == 'Loué'
          && resource.data.get('departureRequested', false) == true
          && resource.data.get('departureReviewId', null) == null
          && request.resource.data.status == 'publie'
          && request.resource.data.availabilityStatus == 'Disponible'
          && request.resource.data.get('tenantUid', null) == null
          && request.resource.data.get('tenantName', null) == null
          && request.resource.data.get('paymentStatus', null) == null
          && request.resource.data.get('departureRequested', false) == false
          && request.resource.data.get('reservedAt', null) == null
          && request.resource.data.departureReviewId is string
          && request.resource.data.departureReviewId.size() <= 100
          && existsAfter(/databases/$(db)/documents/tenantReferences/$(resource.data.tenantUid)/reviews/$(request.resource.data.departureReviewId))
          && changed().hasOnly(tenantKeys()))
        || (role() == 'tenant' && availability(resource.data) == 'Disponible'
          && request.resource.data.status == 'publie'
          && request.resource.data.availabilityStatus == 'Réservé'
          && request.resource.data.get('departureReviewId', null) == null
          && request.resource.data.tenantUid == me()
          && request.resource.data.paymentStatus == null
          && changed().hasOnly(['status','availabilityStatus','tenantUid','tenantName','paymentStatus','reservedAt','departureReviewId']))
        || (resource.data.get('tenantUid', null) == me()
          && availability(resource.data) == 'Réservé'
          && request.resource.data.status == 'publie'
          && request.resource.data.availabilityStatus == 'Disponible'
          && clearsTenant()
          && changed().hasOnly(tenantKeys()))
        || (resource.data.get('tenantUid', null) == me()
          && availability(resource.data) == 'Loué'
          && request.resource.data.get('departureRequested', false) == true
          && changed().hasOnly(['departureRequested']))
      );
      allow delete: if signedIn() && resource.data.ownerUid == me() && availability(resource.data) == 'Disponible';

      match /followers/{uid} {
        function pairedUserFollowExists() {
          return existsAfter(/databases/$(db)/documents/users/$(me())/followedApartments/$(id));
        }
        allow read: if signedIn() && me() == uid && role() == 'tenant';
        allow create: if signedIn() && me() == uid && role() == 'tenant'
          && request.resource.data.uid == uid
          && request.resource.data.apartmentId == id
          && request.resource.data.keys().hasOnly(['uid','apartmentId','ownerUid','title','createdAt'])
          && get(apartmentPath(id)).data.status == 'publie'
          && availability(get(apartmentPath(id)).data) == 'Disponible'
          && get(apartmentPath(id)).data.ownerUid == request.resource.data.ownerUid
          && pairedUserFollowExists();
        allow delete: if signedIn() && me() == uid && role() == 'tenant'
          && !pairedUserFollowExists();
        allow update: if false;
      }
    }

    match /payments/{id} {
      allow read: if signedIn() && (resource.data.ownerUid == me() || resource.data.tenantUid == me());
      allow create: if signedIn() && request.resource.data.tenantUid == me()
        && request.resource.data.status == 'En attente'
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.period is string && request.resource.data.period.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && request.resource.data.method in ['Mobile Money', 'Espèces', 'Banque']
        && request.resource.data.keys().hasOnly(['aptId','aptTitle','ownerUid','tenantUid','tenantName','amount','period','method','reference','status','createdAt'])
        && get(apartmentPath(request.resource.data.aptId)).data.get('tenantUid', null) == me()
        && availability(get(apartmentPath(request.resource.data.aptId)).data) == 'Loué'
        && get(apartmentPath(request.resource.data.aptId)).data.ownerUid == request.resource.data.ownerUid;
      allow update: if signedIn() && resource.data.ownerUid == me() && resource.data.status == 'En attente'
        && request.resource.data.status in ['Validé', 'Refusé']
        && changed().hasOnly(['status','decidedAt','receiptNo','refusalReason']);
      allow delete: if false;
    }

    match /chats/{cid} {
      allow get: if signedIn() && (resource == null || me() in resource.data.participants);
      allow list: if signedIn() && me() in resource.data.participants;
      allow create: if signedIn() && me() in request.resource.data.participants
        && request.resource.data.participants.size() == 2
        && cid == request.resource.data.aptId + '_' + request.resource.data.tenantUid;
      allow update: if signedIn() && me() in resource.data.participants
        && changed().hasOnly(['lastMessage','lastAt','lastSender']);
      allow delete: if false;
      match /messages/{mid} {
        allow read: if signedIn() && me() in get(/databases/$(db)/documents/chats/$(cid)).data.participants;
        allow create: if signedIn()
          && me() in get(/databases/$(db)/documents/chats/$(cid)).data.participants
          && request.resource.data.senderUid == me()
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 4000;
        allow update, delete: if false;
      }
    }

    match /notifications/{nid} {
      allow create: if false;
      allow read, delete: if signedIn() && resource.data.toUid == me();
      allow update: if signedIn() && resource.data.toUid == me()
        && changed().hasOnly(['read'])
        && request.resource.data.read == true;
    }
  }
}
