rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /apartments/{userId}/{allPaths=**} {
      // Tout le monde peut afficher les photos des annonces
      allow read: if true;
      
      // Seul le propriétaire connecté peut uploader dans son dossier,
      // uniquement une image (JPG, PNG, WEBP...) de moins de 5 Mo
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
